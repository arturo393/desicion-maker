# Configuración de Google Gemini API
# ARCHIVO TEMPLATE - RENOMBRA A: .env.gemini
# Descripción: Variables de entorno para integración con Google Gemini API

# 🔐 API Key de Google Gemini (generada desde Google Cloud Console)
# IMPORTANTE: Esta API key NO debe ser compartida públicamente
# 1. Obtén tu API key en: https://aistudio.google.com/app/apikey
# 2. Pega la clave aquí
# 3. Renombra este archivo a .env.gemini
# 4. El archivo .env.gemini está en .gitignore, así que será seguro
GEMINI_API_KEY=tu_api_key_aqui

# Modelo a utilizar (recomendado: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Configuración de API
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models

# Timeout para requests (en segundos)
GEMINI_TIMEOUT=30

# Habilitar/deshabilitar logging (para debug)
GEMINI_DEBUG=false
