# Auto detect text files and perform LF normalization
* text=auto

# Python
*.py text diff=python
*.pyw text
*.pyi text diff=python
*.whl binary

# Documentation
*.md text diff=markdown
*.rst text
*.txt text

# Config files
*.yml text
*.yaml text
*.json text
*.toml text
*.cfg text
*.ini text

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Git files
.gitattributes text
.gitignore text
.gitmodules text

# Generated artifacts
*.png binary
*.jpg binary
*.ico binary
*.svg text
*.pdf binary
*.db binary

# Lock files
uv.lock -text
