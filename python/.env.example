# ============================================================
# PERSONAL DECISION FRAMEWORK CONFIGURATION
# ============================================================
# Copiar este archivo a .env y configurar con tus datos

# ============================================================
# GOOGLE GEMINI API (REQUIRED)
# ============================================================
# Obtener API key en: https://makersuite.google.com/app/apikey
# Free tier: 60 requests/minute
GEMINI_API_KEY=your_api_key_here

# ============================================================
# GEMINI CONFIGURATION (OPTIONAL)
# ============================================================
# Modelo a usar (gemini-pro, gemini-flash, gemini-ultra)
GEMINI_MODEL=gemini-flash

# Temperatura (0.0 = determinístico, 1.0 = creativo)
GEMINI_TEMPERATURE=0.7

# Rate limiting
GEMINI_MAX_REQUESTS_PER_MINUTE=60

# ============================================================
# DEEP RESEARCH PRO (OPTIONAL - REQUIRES ACCESS)
# ============================================================
# Habilitar Deep Research Pro (requiere acceso especial)
GEMINI_DEEP_RESEARCH_ENABLED=false

# ============================================================
# FRAMEWORK CONFIGURATION
# ============================================================
# ¿Usar framework Python? (true/false)
DECISION_FRAMEWORK_PYTHON=true

# ¿Usar framework C++? (true/false)
# Requiere compilar con CMake primero
DECISION_FRAMEWORK_CPP=false

# ============================================================
# LOCAL PATHS (OPTIONAL - AUTO-DETECTED)
# ============================================================
# Directorio donde guardar resultados
RESULTS_DIR=./results/

# Directorio con análisis
ANALYSIS_DIR=./analyses/

# ============================================================
# PERSONAL PREFERENCES
# ============================================================
# Número de iteraciones Monte Carlo (default: 10000)
MONTE_CARLO_ITERATIONS=10000

# Nivel de confianza para análisis de riesgo (0.90, 0.95, 0.99)
CONFIDENCE_LEVEL=0.95

# Guardar resultados intermedios (true/false)
SAVE_INTERMEDIATE_RESULTS=true

# ============================================================
# SECURITY NOTES
# ============================================================
# 🔒 NUNCA subir .env a Git (ya está en .gitignore)
# 🔒 NUNCA compartir tu GEMINI_API_KEY públicamente
# 🔒 Resultados en /results/ SÍ se suben a Git (datos personales)
